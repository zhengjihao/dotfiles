# claude code的alias

alias zjh='claude --dangerously-skip-permissions'

# 安装的mit程序的alias

alias bat='batcat'

alias fd='fdfind'

# 安装、更新、卸载的alias

alias az='sudo apt install -y'

alias gx='sudo apt update && sudo apt upgrade -y && claude update && codex update && opencode upgrade && echo "更新已完成！重启后加载最新配置，不着急也可以不重启"'

alias xz='sudo apt remove --purge'
